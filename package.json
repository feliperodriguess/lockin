{
	"name": "lockin",
	"version": "1.1.4",
	"description": "Unofficial League companion — matchup notes, ban planning, and build guidance live in Champ Select",
	"main": "./out/main/index.js",
	"author": "Felipe Rodrigues <felipeaugustorodrigues1@gmail.com>",
	"homepage": "https://github.com/feliperodriguess/lockin",
	"repository": {
		"type": "git",
		"url": "https://github.com/feliperodriguess/lockin.git"
	},
	"packageManager": "pnpm@11.5.2",
	"scripts": {
		"format": "biome check --write --unsafe .",
		"typecheck": "tsc --noEmit -p tsconfig.json --composite false",
		"test": "vitest run --passWithNoTests",
		"start": "electron-vite preview",
		"dev": "electron-vite dev",
		"build": "npm run typecheck && electron-vite build",
		"postinstall": "electron-builder install-app-deps",
		"build:unpack": "npm run build && electron-builder --dir",
		"build:win": "npm run build && electron-builder --win",
		"build:mac": "npm run build && electron-builder --mac"
	},
	"dependencies": {
		"@electron-toolkit/utils": "^4.0.0",
		"electron-store": "^11.0.2",
		"league-connect": "6.0.0-rc13"
	},
	"devDependencies": {
		"@base-ui/react": "^1.5.0",
		"@electron-toolkit/preload": "^3.0.2",
		"@fontsource/instrument-serif": "^5.2.8",
		"@fontsource/jetbrains-mono": "^5.2.8",
		"@fontsource/poppins": "^5.2.7",
		"@tailwindcss/vite": "^4.3.0",
		"@tanstack/react-query": "^5.101.0",
		"@tanstack/react-router": "^1.170.11",
		"@testing-library/react": "^16.3.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.17.0",
		"motion": "^12.40.0",
		"react": "^19.2.1",
		"react-dom": "^19.2.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-scrollbar": "^4.0.2",
		"tailwindcss": "^4.3.0",
		"@types/node": "^22.19.1",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.1",
		"electron": "^39.2.6",
		"electron-builder": "^26.0.12",
		"electron-vite": "^5.0.0",
		"jsdom": "^29.1.1",
		"tsx": "^4.22.4",
		"typescript": "^5.9.3",
		"vite": "^7.2.6",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.8"
	}
}
